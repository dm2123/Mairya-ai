{
  "name": "mairya-ai-api",
  "version": "1.0.0",
  "description": "Maurya AI - Backend API Service",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.ts' --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "keywords": ["maurya", "ai", "backend", "api"],
  "author": "Maurya AI",
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2",
    "helmet": "^7.0.0",
    "cors": "^2.8.5",
    "morgan": "^1.10.0",
    "reflect-metadata": "^0.1.14"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.2"
  }
}
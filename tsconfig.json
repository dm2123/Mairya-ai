{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "module": "CommonJS",
    "target": "esnext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "allowJs": true,
    "skipLibCheck": true,

    "paths": {
      "/*": ["./*"],
      "@maurya/shared": ["./packages/shared/src"],
      "@maurya/database": ["./packages/database/src"],
      "@maurya/api": ["./apps/api/src"]
    }
  },
  "include": [
    "apps/api/src/**/*",
    "packages/shared/src/**/*",
    "packages/database/src/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
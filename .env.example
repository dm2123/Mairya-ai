# Maurya AI - Environment Configuration Examples
# Never commit real .env files. Use as templates only.

# ============================================================
# Environment Mode (required - determine via NODE_ENV or MAURYA_ENV)
# ============================================================
NODE_ENV=development      # or: test, staging, production
MAURYA_ENV=development    # optional override

# ============================================================
# Application
# ============================================================
APP_NAME=Maurya AI
APP_VERSION=1.0.0
PORT=3000
HOST=0.0.0.0

# ============================================================
# API
# ============================================================
API_PREFIX=/api/v1

# ============================================================
# CORS - comma-separated list of allowed origins
# ============================================================
# Development: localhost origins are fine
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Production: must list explicit origins, never use "*"

# ============================================================
# Rate Limiting
# ============================================================
RATE_LIMIT_WINDOW=900000     # 15 minutes in ms
RATE_LIMIT_MAX_REQUESTS=100  # per window

# ============================================================
# Database
# ============================================================
DATABASE_URL=sqlite:./mairya-ai.db

# ============================================================
# AI Gateway (optional - placeholder)
# ============================================================
AI_PROVIDER=local
AI_BASE_URL=http://localhost:8000
AI_API_KEY=sk-test-key-may-be-changed
AI_DEFAULT_MODEL=gpt-4o

# ============================================================
# GitHub Integration (optional)
# ============================================================
GITHUB_OWNER=dm2123
GITHUB_REPO=Mairya-ai
# GITHUB_TOKEN=ghp_...     # uncomment and set when GitHub integration is configured

# ============================================================
# Email (optional)
# ============================================================
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
# EMAIL_USERNAME=user@domain.com   # uncomment when configured
# EMAIL_PASSWORD=***********       # uncomment when configured
# EMAIL_FROM=Maurya AI <no-reply@maurya.ai>

# ============================================================
# WhatsApp (optional)
# ============================================================
# WHATSAPP_ACCESS_TOKEN=***********   # uncomment when configured
# WHATSAPP_PHONE_NUMBER_ID=********** # uncomment when configured
# WHATSAPP_VERIFY_TOKEN=maurya.ai   # uncomment when configured

# ============================================================
# Payment (optional)
# ============================================================
# PAYMENT_PROVIDER=stripe
# PAYMENT_PUBLIC_KEY=pk_test_...     # uncomment when configured
# PAYMENT_SECRET_KEY=sk_test_...     # uncomment when configured
# PAYMENT_WEBHOOK_SECRET=whsec_...   # uncomment when configured

# ============================================================
# Storage
# ============================================================
STORAGE_PROVIDER=local
STORAGE_BASE_PATH=./storage

# ============================================================
# Deployment
# ============================================================
DEPLOYMENT_PROVIDER=preview
DEPLOYMENT_ENV=preview

# ============================================================
# Security / Authentication (optional - for future auth)
# ============================================================
# JWT_SECRET=change-this-in-production    # REQUIRED for auth later
# SESSION_SECRET=change-this-in-production # REQUIRED for auth later

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=debug      #: debug, info, warn, error